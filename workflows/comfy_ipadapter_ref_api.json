{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "RealVisXL_V5.0_fp16.safetensors" }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": { "image": "keth_ref.png" }
  },
  "3": {
    "class_type": "IPAdapterUnifiedLoader",
    "inputs": { "model": ["1", 0], "preset": "PLUS FACE (portraits)" }
  },
  "4": {
    "class_type": "IPAdapter",
    "inputs": {
      "model": ["3", 0],
      "ipadapter": ["3", 1],
      "image": ["2", 0],
      "weight": 0.85,
      "start_at": 0.0,
      "end_at": 1.0,
      "weight_type": "standard"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["1", 1], "text": "POSITIVE_PLACEHOLDER" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["1", 1], "text": "NEGATIVE_PLACEHOLDER" }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0],
      "seed": 12345,
      "steps": 30,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["8", 0], "vae": ["1", 2] }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": { "images": ["9", 0], "filename_prefix": "ipadapter_test" }
  }
}
