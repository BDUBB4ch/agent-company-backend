# Copy this file to .env and fill in what you use.
# .env is where secrets live - never share this file or paste it into chat.

# Optional - only needed for agents set to backend "claude" in agents.py.
# Leave blank to run 100% free on local Ollama.
ANTHROPIC_API_KEY=

# Which Claude model to use when an agent calls Claude
CLAUDE_MODEL=claude-sonnet-5

# Ollama - defaults assume Ollama is running locally with default settings.
#
# WARNING (fixed 2026-08-13): this line used to read "qwen2.5:14b", a model
# that is NOT installed on this machine. Setting it would have broken Vivian
# outright -- main.py pins CREATIVE_ID to config.OLLAMA_MODEL, so an
# uninstalled value here takes her offline. Only set OLLAMA_MODEL if you
# genuinely want to override the office default; leaving it OUT of .env is
# safer than copying it in, because config.py already holds the right value.
OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=huihui_ai/qwen3.5-abliterated:9b

# Local server settings
APP_HOST=127.0.0.1
APP_PORT=8420

# --- Live store access for the agents (read-only WooCommerce) ---
# Lets Amara/Derek/Victor pull real revenue and top sellers, and
# Amara/Derek/Victor/Vivian look up real product prices and stock, instead of
# answering from memory. See backend/store.py.
#
# Generate the pair in WordPress:
#   WooCommerce -> Settings -> Advanced -> REST API -> Add key
#   Description: anything. User: yourself. PERMISSIONS: **Read** (not Read/Write)
# WooCommerce shows the key and secret ONCE. If you lose them, revoke and
# make a new pair -- no harm done.
#
# Read permission means the STORE itself refuses any write, so no bug in this
# codebase can change your products, orders or prices.
STORE_URL=https://bdubbgrowsllc.com
STORE_CONSUMER_KEY=
STORE_CONSUMER_SECRET=
